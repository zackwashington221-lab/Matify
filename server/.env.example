PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/martify
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
# The API accepts requests from all origins; no CORS_ORIGIN setting is required.
ADMIN_APP_URL=http://localhost:3000
RESEND_API_KEY=re_your_resend_api_key
# Use onboarding@resend.dev for Resend's test domain, or a sender at your verified domain.
RESEND_FROM=Martify Admin <onboarding@resend.dev>
GEMINI_API_KEY=your-gemini-api-key
# Supported default: gemini-2.5-flash-lite
GEMINI_MODEL=gemini-2.5-flash-lite
