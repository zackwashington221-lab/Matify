{
  "expo": {
    "name": "Freshly",
    "slug": "freshly",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "freshly",
    "userInterfaceStyle": "light",
    "splash": { "resizeMode": "contain", "backgroundColor": "#faf8f5" },
    "ios": { "supportsTablet": true, "bundleIdentifier": "io.freshly.app" },
    "android": { "package": "io.freshly.app", "adaptiveIcon": { "backgroundColor": "#faf8f5" } },
    "web": { "bundler": "metro" },
    "extra": { "apiUrl": "http://localhost:4000/api" }
  }
}
