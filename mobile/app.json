{
  "expo": {
    "name": "Martify",
    "slug": "martify",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "martify",
    "userInterfaceStyle": "light",

    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.martify.app"
    },

    "android": {
      "package": "com.martify.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#faf8f5"
      }
    },

    "web": {
      "bundler": "metro"
    },

    "extra": {
      "apiUrl": "http://localhost:4000/api",
      "useMockData": false
    },

    "plugins": ["expo-font"]
  }
}
